# Copy to `.env` and edit for a real deployment: `cp .env.example .env`.
# docker-compose.yml falls back to these same defaults, so `docker compose up`
# works even without this file — but DO set real secrets before exposing it.

# --- Parley gateway ---------------------------------------------------------
# Admin secret. Mints per-agent tokens and authenticates admin REST calls.
# Generate one with:  openssl rand -hex 32
PARLEY_ADMIN_TOKEN=dev-parley-admin-token
# Host port the REST API is published on (container always listens on 8790).
PARLEY_PORT=8790
# Host port the MCP endpoint is published on (container always listens on 8791).
PARLEY_MCP_PORT=8791
# Postgres schema Parley creates/uses.
PARLEY_PG_SCHEMA=parley

# --- Postgres ---------------------------------------------------------------
POSTGRES_DB=parley
POSTGRES_USER=parley
POSTGRES_PASSWORD=parley

# --- tyo-mq transport -------------------------------------------------------
# Shared secret Parley uses to authenticate to the broker. MUST match on both
# the tyomq broker and the parley service (compose wires both from this one var).
# Generate one with:  openssl rand -hex 32
MQ_TOKEN=dev-parley-mq-token
# Wildcard admin/ops token for the broker (manager commands).
TYO_MQ_ADMIN_TOKEN=dev-tyomq-admin-token
# Realm Parley's messages/nudges live in on the broker.
PARLEY_MQ_REALM=parley
# Where the tyo-mq broker source lives (used as the Docker build context).
TYOMQ_SRC=/data/tyolab/node/tyo-mq
